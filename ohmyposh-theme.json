{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "\ue285 ",
    "foreground": "#FEF5ED",
    "background": "transparent"
  },
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "leading_diamond": "\u256d\u2500",
          "template": " {{ if .WSL }}\ue712 on {{ end }}{{ .Icon }}  ",
          "foreground": "#FFF",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "display_host": true
          },
          "template": "{{ .UserName }} ",
          "foreground": "#ffffff",
          "type": "session",
          "style": "diamond"
        },
        {
          "properties": {
            "branch_icon": "\ue725 ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "template": "<#fff>{{ .UpstreamIcon }}</>{{ .HEAD }}",
          "foreground": "#ff0000",
          "type": "git",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "foreground": "#fff",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "style": "dallas",
            "threshold": 0
          },
          "template": " <#BBC4B9>{{ .FormattedMs }}s</> <#fff>\udb80\udddd</>",
          "foreground": "#fff",
          "type": "executiontime",
          "style": "diamond"
        },
        {
          "properties": {
            "time_format": "Monday <#fff>at</> 3:04 PM"
          },
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#BBC4B9",
          "type": "time",
          "style": "diamond"
        },
        {
          "properties": {
            "root_icon": "\uf292 "
          },
          "template": " \uf0e7",
          "type": "root",
          "style": "diamond"
        },
        {
          "template": " <#fff>\ue718</> {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#BBC4B9",
          "type": "node",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "folder_icon": "/",
            "folder_separator_icon": " / ",
            "home_icon": "home",
            "style": "agnoster_full"
          },
          "leading_diamond": "<#FFF>\u2570\u2500</>",
          "template": " \ue5ff {{ .Path }}",
          "foreground": "#ff0000",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "always_enabled": true
          },
          "template": " \uf120 ",
          "foreground": "#FFF",
          "type": "status",
          "style": "diamond",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#39FF14{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
